#!/usr/bin/env python3
"""Tell /agents whether this seat is busy and who is driving it.

Run by Claude Code's managed hooks (40-developer-seat.json) with the event on
stdin, and writes ~/.claude/seat-state.json:

  seat-state prompt   UserPromptSubmit. Every prompt starts a turn: turn is
                      active from turn_started. A prompt a person typed also
                      marks the seat busy and manual, with the session's
                      first prompt as its task. A cross-session message
                      (Josui Prime's assignments) reaches this hook too,
                      opening with <cross-session-message>, and leaves
                      state, owner and task alone.
  seat-state stop     Stop and StopFailure. The turn is over: turn is idle
                      from turn_ended. Claude Code runs neither when a person
                      interrupts a turn, so an interrupted turn stays active
                      until the next prompt ends or the seat restarts.
  seat-state start    SessionStart. A new process (startup, resume) or a
                      /clear is not mid-turn, so turn is idle. source=clear
                      also frees the seat and pins the new conversation's
                      UUID for developer-worker-claude, so a respawn does not
                      bring back the cleared one. source=compact can come
                      mid-turn and changes nothing.

A hook must never stand between a person and their prompt: every failure is
reported on stderr and the exit is 0. Nothing goes to stdout, which
UserPromptSubmit would add to the conversation.
"""

from __future__ import annotations

import json
import os
import re
import sys
import tempfile
from datetime import UTC, datetime
from pathlib import Path
from typing import Any

TASK_LENGTH = 120
PEER_MARK = "<cross-session-message"
UUID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")


def write_atomically(path: Path, text: str) -> None:
    """Replace path in one step, through a temporary file beside it."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(text)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def read_state(path: Path) -> dict[str, Any]:
    """The seat's state, or {} when there is none yet or it cannot be used."""
    try:
        state = json.loads(path.read_text())
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as exc:
        print(f"seat-state: {path} is unreadable, replacing it: {exc}", file=sys.stderr)
        return {}
    if not isinstance(state, dict):
        print(f"seat-state: {path} is not a JSON object, replacing it", file=sys.stderr)
        return {}
    return state


def now() -> str:
    return datetime.now(UTC).isoformat(timespec="seconds")


def idle(state: dict[str, Any]) -> dict[str, Any]:
    """state with the turn over as of now."""
    return {**state, "turn": "idle", "turn_ended": now()}


def on_prompt(event: dict[str, Any], state_path: Path) -> None:
    """UserPromptSubmit: a turn starts; a typed prompt makes the seat busy and manual."""
    prompt = str(event.get("prompt", ""))
    session = str(event.get("session_id", ""))
    state = read_state(state_path)
    # Claude Code hands a peer's message to the hook wrapped and with nothing
    # before it; a person who quotes the tag later in a prompt is still a person.
    peer = prompt.lstrip().startswith(PEER_MARK)
    kept = state.get("session_id") == session and state.get("owner") == "manual" and state.get("task")
    if not peer and not kept:
        state = {
            "state": "busy",
            "owner": "manual",
            "task": prompt.strip()[:TASK_LENGTH],
            "since": now(),
            "session_id": session,
        }
    state.pop("turn_ended", None)
    seat = {**state, "turn": "active", "turn_started": now()}
    write_atomically(state_path, json.dumps(seat) + "\n")


def on_stop(state_path: Path) -> None:
    """Stop and StopFailure: the turn is over."""
    write_atomically(state_path, json.dumps(idle(read_state(state_path))) + "\n")


def on_start(event: dict[str, Any], state_path: Path, pin_path: Path) -> None:
    """SessionStart: no turn is running; /clear frees the seat and pins the new session's UUID."""
    source = event.get("source")
    if source in ("startup", "resume"):
        write_atomically(state_path, json.dumps(idle(read_state(state_path))) + "\n")
    if source != "clear":
        return
    session = str(event.get("session_id", ""))
    seat = idle({"state": "free", "since": now(), "session_id": session})
    write_atomically(state_path, json.dumps(seat) + "\n")
    if UUID.match(session):
        write_atomically(pin_path, session + "\n")
    else:
        print(f"seat-state: session id {session!r} is not a UUID, not pinned", file=sys.stderr)


def main(argv: list[str]) -> int:
    home = Path.home()
    state_path = home / ".claude/seat-state.json"
    pin_path = home / ".config/josui/session-id"
    try:
        event = json.load(sys.stdin)
        if not isinstance(event, dict):
            raise ValueError("the event is not a JSON object")
        if argv[1:] == ["prompt"]:
            on_prompt(event, state_path)
        elif argv[1:] == ["stop"]:
            on_stop(state_path)
        elif argv[1:] == ["start"]:
            on_start(event, state_path, pin_path)
        else:
            raise ValueError(f"usage: seat-state prompt|stop|start, not {argv[1:]}")
    except (OSError, ValueError) as exc:
        print(f"seat-state: {exc}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
